#!/usr/bin/env bash
# Automatically resolve absolute path of SPLICEPROBREPO directory
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$PROJECT_DIR/env"

setup_env() {
  if [ ! -f "$VENV_DIR/bin/activate" ]; then
    echo "=== No virtual environment found, creating one ==="
    python3 -m venv "$VENV_DIR"
  fi

  echo "=== Installing/updating dependencies ==="
  source "$VENV_DIR/bin/activate"
  pip install --upgrade pip
  pip install -r "$PROJECT_DIR/requirements.txt"
  deactivate
}

run_backend() {
  x-terminal-emulator -e bash -c "
    cd '$PROJECT_DIR'
    [ -f '$VENV_DIR/bin/activate' ] && source '$VENV_DIR/bin/activate'
    echo '=== Starting FastAPI Backend (Port 8000) ==='
    trap 'echo Shutting down FastAPI...; kill 0' EXIT INT TERM
    fastapi dev app/main.py
  " &
}

run_frontend() {
  x-terminal-emulator -e bash -c "
    cd '$PROJECT_DIR'
    [ -f '$VENV_DIR/bin/activate' ] && source '$VENV_DIR/bin/activate'
    echo '=== Starting Frontend Server (Port 5500) ==='
    trap 'echo Shutting down Frontend...; kill 0' EXIT INT TERM
    python3 frontend/serve.py
  " &
}

case "$1" in
  setup)
    setup_env
    ;;
  run)
    echo "Launching FastAPI backend and Frontend server..."
    run_backend
    run_frontend
    ;;
  all)
    setup_env
    echo "Launching FastAPI backend and Frontend server..."
    run_backend
    run_frontend
    ;;
  *)
    echo "Usage: myapp {setup|run|all}"
    echo "  setup  - create venv (if missing) and install/update requirements.txt"
    echo "  run    - launch backend and frontend (assumes venv already set up)"
    echo "  all    - setup + run in one go"
    exit 1
    ;;
esac
